# 이 파일을 .env 로 복사해서 값을 채운다: cp .env.example .env   (.env 는 커밋하지 않는다)
DATABASE_URL=
JWT_SECRET=
JWT_TTL_MINUTES=60
DEV_SKIP_AUTH=false
LLM_MODE=fake            # fake | real
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SEC=600
LLM_MAX_TOKENS=64000
ANTHROPIC_API_KEY=
AUTO_RETRY_LIMIT=3
MANAGER_REQUEST_LIMIT=2
ENABLE_SURPLUS=false
ENABLE_HALF_LEAVE_CHECK=false
ENABLE_REGULAR_AVAILABILITY_WARNING=false
ENABLE_CONTACT=false
RUNNER=local             # local | aegra
AEGRA_URL=http://127.0.0.1:2026
PUBLIC_BASE_URL=http://127.0.0.1:5173
POSTGRES_PASSWORD=
LINE_MODE=stub           # stub | line  (line 이면 아래 세 값이 하나라도 비어 있을 때 시작하지 않는다)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OFFICIAL_ACCOUNT_ID=

# 호스트에서 Aegra 를 볼 포트. 2026 을 다른 프로젝트가 쓰고 있으면 바꾼다 (컨테이너 안은 그대로 2026)
AEGRA_HOST_PORT=2026
